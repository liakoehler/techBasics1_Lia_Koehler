def load_records():
    records = []

    try:
        with open(FILENAME, "r", newline="", encoding="utf-8") as file:
            reader = csv.reader(file)

            for row in reader:
                records.append(row)

    except FileNotFoundError:
        print("Keine vorhandene Rekord-Datei gefunden.")

    except Exception as error:
        print("Fehler beim Laden:", error)

    return records


def save_record(name, seconds_used):
    records = load_records()

    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    records.append([
        name,
        timestamp,
        round(seconds_used, 2)
    ])

    try:
        with open(FILENAME, "w", newline="", encoding="utf-8") as file:
            writer = csv.writer(file)

            for record in records:
                writer.writerow(record)

    except Exception as error:
        print("Fehler beim Speichern:", error)


def show_leaderboard():
    records = load_records()

    if len(records) == 0:
        print("\nNoch keine Einträge vorhanden.")
        return

    print("\n" + "=" * 50)
    print("🏆 LEADERBOARD")
    print("=" * 50)

    try:
        records.sort(key=lambda x: float(x[2]))

        for position, record in enumerate(records, start=1):
            print(
                f"{position}. "
                f"{record[0]} | "
                f"{record[1]} | "
                f"Zeit: {record[2]} Sekunden"
            )

    except Exception as error:
        print("Fehler beim Anzeigen:", error)

